# ============================================================
# SKINMARKET ES - PRODUCTION ENVIRONMENT VARIABLES
# ============================================================
# Copy this file to .env and fill in your values
# cp .env.production.example .env
# ============================================================

# ============================================================
# DOMAIN CONFIGURATION
# ============================================================
DOMAIN=https://yourdomain.com            # Your actual domain (e.g., https://steamclubclash.gg)
FRONTEND_URL=${DOMAIN}
BACKEND_URL=${DOMAIN}
NODE_ENV=production

# ============================================================
# DATABASE (PostgreSQL)
# ============================================================
DB_USER=postgres
DB_PASSWORD=your_strong_db_password_here  # CHANGE THIS - 20+ chars recommended
DB_NAME=skinmarket
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@db:5432/${DB_NAME}

# ============================================================
# REDIS (Cache & Sessions)
# ============================================================
REDIS_PASSWORD=your_redis_password_here   # CHANGE THIS
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379

# ============================================================
# JWT & SECURITY
# ============================================================
JWT_SECRET=your_jwt_secret_key_64_chars_minimum_here_change_this_please  # CHANGE THIS - use: openssl rand -hex 64

# ============================================================
# STEAM API
# ============================================================
STEAM_API_KEY=your_steam_api_key_here      # Get from: https://steamcommunity.com/dev/apikey

# ============================================================
# STEAM BOT CREDENTIALS
# ============================================================
# Create a secondary Steam account for the bot (NOT your main account)
BOT_USERNAME=your_bot_steam_username
BOT_PASSWORD=your_bot_steam_password
BOT_SHARED_SECRET=your_bot_shared_secret   # From SDA (Steam Desktop Authenticator) - base64
BOT_IDENTITY_SECRET=your_bot_identity_secret # From SDA - base64

# ============================================================
# SERVER
# ============================================================
PORT=3001

