# =============================================================================
# SKINMARKET ES - ENVIRONMENT VARIABLES
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# --- SERVER CONFIGURATION ---
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3001

# --- DATABASE (PostgreSQL) ---
# Example: postgresql://username:password@localhost:5432/skinmarket
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/skinmarket

# --- REDIS (Session Store & Caching) ---
# Example: redis://localhost:6379 or rediss://username:password@host:port
REDIS_URL=redis://localhost:6379

# --- JWT (Authentication) ---
# Generate a strong secret: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_change_this_in_production

# --- STEAM API (OpenID & Market Data) ---
# Get your API key at: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=your_steam_api_key_here

# --- GOOGLE OAUTH (Google Sign-In) ---
# Get your credentials at: https://console.cloud.google.com/apis/credentials
# Create an OAuth 2.0 Client ID (Web application type)
GOOGLE_CLIENT_ID=your_google_client_id_here
# Frontend env var (VITE_ prefix for Vite exposure):
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here
VITE_API_URL=http://localhost:3001

# --- STEAM BOT (Trade Offers Automation) ---
# IMPORTANT: The bot must have Steam Guard (2FA) enabled.
# The shared_secret can be obtained from the SteamDesktopAuthenticator (SDA) 
# or by decoding your .maFile using steam-totp.

# Steam account credentials for the bot
BOT_USERNAME=tu_usuario_steam
BOT_PASSWORD=tu_password_steam

# Two-Factor Authentication (Steam Guard) secrets
# Generate using: steam-totp or SteamDesktopAuthenticator
# Leave as defaults to run in SIMULATION MODE (no real trades)
BOT_SHARED_SECRET=your_shared_secret_here
BOT_IDENTITY_SECRET=your_identity_secret_here

# --- OPTIONAL: STORAGE & EXTERNAL SERVICES ---
# (Add any additional API keys or service URLs below)

# --- LEGACY / TYPICAL ADDITIONS ---
# SESSION_SECRET (fallback if JWT_SECRET is not used for sessions)
SESSION_SECRET=your_session_secret_change_this

# =============================================================================
# NOTES:
# =============================================================================
# 1. In development, set NODE_ENV=development for detailed error logging.
# 2. Set NODE_ENV=production in production to disable stack traces.
# 3. The Steam Bot runs in SIMULATION MODE if BOT_USERNAME is 'tu_usuario_steam'
#    or if BOT_SHARED_SECRET is not properly configured.
# 4. Skin prices are cached locally in public/skin_prices.json via
#    the generate_prices_cache.js script (run: node generate_prices_cache.js).
# 5. To test trades in simulation mode, leave the default bot credentials.
# =============================================================================

